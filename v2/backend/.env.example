# FIREX v2 Environment Configuration -- TEMPLATE
#
# Copy this file to `.env` in the same directory and fill in real values:
#     cp v2/backend/.env.example v2/backend/.env
#
# `.env` is gitignored and is the only place credentials may live.
# The previous revision of this file was byte-identical to the live `.env`,
# which committed a working NASA FIRMS key to the repository.

ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Database URL.
# A relative SQLite path is resolved against v2/backend/ by app/core/config.py,
# so the line below always means v2/backend/data/firex_v2.db regardless of the
# directory the server is started from.
# For PostgreSQL / PostGIS: postgresql://postgres:postgres@localhost:5432/firex_v2
DATABASE_URL=sqlite:///./data/firex_v2.db

# NASA FIRMS Ingestion -- request a key at
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=replace-with-your-firms-map-key
FIRMS_REGION=68.7,8.4,97.4,37.6
FIRMS_DAYS=2

# Vision AI.
# AI_MODEL is the single source of truth for the vision model id.
# OPENROUTER_API_KEYS is a JSON list; keys are tried in order and rotated on
# failure. See app/intelligence/key_pool.py.
AI_PROVIDER=openrouter
AI_MODEL=dots-studio/dots-3-note-preview:free
AI_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEYS=["replace-with-your-openrouter-key"]

# Key rotation policy (Section 6.3)
AI_KEY_COOLDOWN_SECONDS=60
AI_KEY_QUARANTINE_SECONDS=3600

# Optional API key auth (disabled by default for zero-friction local demo)
API_KEY_AUTH_ENABLED=False
ADMIN_API_KEY=replace-with-a-random-admin-key

# Optional database URL used only when testing against PostgreSQL/PostGIS
